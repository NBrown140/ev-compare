{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EV Compare Sources",
  "description": "Maps vehicle IDs to their data sources with archived URLs",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "object",
      "required": ["url", "fields"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://web\\.archive\\.org/web/",
          "description": "Wayback Machine archived URL"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "CSV fields this source covers"
        }
      }
    }
  }
}
